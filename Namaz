// ============================================================
// ГЛОБАЛНИ ПРОМЕНЛИВИ ЗА АВТОМАТСКИ
// ============================================================
let autoTimer = null;
let autoPaused = false;
let autoRunning = false;
let autoQueue = [];
let autoCurrentIndex = 0;
let autoTotalSteps = 0;
let isSpeaking = false;

// ============================================================
// ПРЕБАРУВАЊЕ ПОЛОЖБА ПО ID
// ============================================================
function getPos(id) { return positions.find(p => p.id === id); }

// ============================================================
// SPEAK – ПОБАВНО И ПОЈАСНО (rate 0.55)
// ============================================================
function speakText(text, callback) {
  if (!window.speechSynthesis) {
    if (callback) callback();
    return;
  }
  window.speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(text);
  u.lang = "mk-MK";
  u.rate = 0.55;
  u.pitch = 0.9;
  u.volume = 1;
  u.onend = function() { if (callback) callback(); };
  u.onerror = function(e) {
    const u2 = new SpeechSynthesisUtterance(text);
    u2.lang = "en-US";
    u2.rate = 0.55;
    u2.pitch = 0.9;
    u2.volume = 1;
    u2.onend = function() { if (callback) callback(); };
    window.speechSynthesis.speak(u2);
  };
  window.speechSynthesis.speak(u);
}

// ============================================================
// makeBox – СО data-speak И КОПИРАЊЕ
// ============================================================
function makeBox(ar, tr, mk, speak, note="", copyTextRaw="") {
  const safeSpeak = speak.replace(/'/g, "\\'").replace(/"/g, '&quot;');
  const copyAttr = copyTextRaw ? copyTextRaw.replace(/"/g, '&quot;') : ar.replace(/"/g, '&quot;');
  return `<div class="dua-box">
    <div class="arabic">${ar}</div>
    <div class="translit">${tr}</div>
    <div class="meaning"><strong>На македонски:</strong> ${mk}</div>
    <button class="audio-btn" data-speak="${safeSpeak}">🔊 Слушни</button>
    <button class="copy-btn-action" onclick="copyText('${copyAttr}')">📋 Копирај</button>
    ${note ? `<div class="note">${note}</div>` : ""}
  </div>`;
}

// ============================================================
// SWITCH MODE
// ============================================================
function switchMode(mode) {
  ["auto","manual","abdest","allduas"].forEach(m => {
    const el = document.getElementById("tab" + m.charAt(0).toUpperCase() + m.slice(1));
    if (el) el.classList.toggle("active", m === mode);
    document.getElementById(m + "Mode").classList.toggle("hidden", m !== mode);
  });
  if (mode !== "auto") stopAutoGuide();
  document.getElementById("autoResult").classList.add("hidden");
  document.getElementById("manualResult").classList.add("hidden");
}

// ============================================================
// АВТОМАТСКИ ВОДИЧ
// ============================================================
function onAutoNamazChange() {
  stopAutoGuide();
  document.getElementById("autoResult").classList.add("hidden");
  document.getElementById("autoStatus").textContent = "Избери намаз и кликни Стартувај";
  document.getElementById("autoDetail").textContent = "";
  document.getElementById("autoProgressFill").style.width = "0%";
}

function buildAutoQueue(namazKey) {
  const data = namazData[namazKey];
  if (!data) return [];
  const queue = [];
  data.parts.forEach((part, pIdx) => {
    for (let r = 1; r <= part.count; r++) {
      const isLast = (r === part.count);
      const posList = positions.filter(p => {
        if (p.id === "tashahhud" && !(r === 2 || isLast || part.count === 1)) return false;
        if (p.id === "salam" && !isLast) return false;
        return true;
      });
      posList.forEach(pos => {
        queue.push({
          partIndex: pIdx,
          partLabel: part.label,
          rakatInPart: r,
          totalInPart: part.count,
          posId: pos.id
        });
      });
    }
  });
  return queue;
}

function startAutoGuide() {
  if (autoRunning) return;
  const key = document.getElementById("namazAuto").value;
  if (!key) { alert("Избери намаз!"); return; }
  autoQueue = buildAutoQueue(key);
  if (autoQueue.length === 0) return;
  autoCurrentIndex = 0;
  autoTotalSteps = autoQueue.length;
  autoRunning = true;
  autoPaused = false;
  isSpeaking = false;
  document.getElementById("startAutoBtn").classList.add("hidden");
  document.getElementById("pauseAutoBtn").classList.remove("hidden");
  document.getElementById("stopAutoBtn").classList.remove("hidden");
  document.getElementById("autoResult").classList.remove("hidden");
  document.getElementById("autoProgressFill").style.width = "0%";
  document.getElementById("autoStatus").textContent = "Во тек...";
  runAutoStep();
}

function runAutoStep() {
  if (!autoRunning || autoPaused) return;
  if (autoCurrentIndex >= autoQueue.length) {
    finishAutoGuide();
    return;
  }
  const step = autoQueue[autoCurrentIndex];
  const pos = getPos(step.posId);
  if (!pos) { autoCurrentIndex++; runAutoStep(); return; }

  const progress = ((autoCurrentIndex) / autoTotalSteps * 100);
  document.getElementById("autoProgressFill").style.width = progress + "%";
  document.getElementById("autoPosTitle").textContent =
    `${pos.name} – ${step.partLabel} (${step.rakatInPart}. рекат)`;
  document.getElementById("autoDetail").textContent =
    `Чекор ${autoCurrentIndex+1} од ${autoTotalSteps} • ${step.partLabel} • ${step.rakatInPart}/${step.totalInPart}`;
  setAutoAnimation(pos.id);
  renderAutoDua(pos.id, step.rakatInPart, step.totalInPart);

  const speakCheck = document.getElementById("autoSpeakCheck");
  if (speakCheck && speakCheck.checked) {
    const speakTexts = getSpeakTexts(pos.id, step.rakatInPart, step.totalInPart);
    if (speakTexts && speakTexts.length > 0) {
      isSpeaking = true;
      let idx = 0;
      function speakNext() {
        if (!autoRunning || autoPaused || idx >= speakTexts.length) {
          isSpeaking = false;
          autoTimer = setTimeout(() => {
            autoCurrentIndex++;
            runAutoStep();
          }, 400);
          return;
        }
        speakText(speakTexts[idx], function() {
          idx++;
          setTimeout(speakNext, 400);
        });
      }
      speakNext();
      return;
    }
  }

  let delay = 3500;
  if (pos.id === "kiyam" || pos.id === "tashahhud") delay = 6000;
  if (pos.id === "tekbir" || pos.id === "between" || pos.id === "after_ruku") delay = 2500;
  autoTimer = setTimeout(() => {
    autoCurrentIndex++;
    runAutoStep();
  }, delay);
}

function getSpeakTexts(posId, rakatNum, totalInPart) {
  const isFirst = rakatNum === 1;
  const isLast = rakatNum === totalInPart;
  const texts = [];

  if (posId === "tekbir") {
    texts.push(DUAS.tekbir.speak);
  }
  else if (posId === "kiyam") {
    if (isFirst) {
      texts.push(DUAS.subhanaka.speak);
      texts.push(DUAS.auzu.speak);
    }
    texts.push(DUAS.fatiha.speak);
    if (rakatNum <= 2) {
      texts.push(DUAS.sura.speak);
    }
  }
  else if (posId === "ruku") {
    for (let i = 0; i < 3; i++) texts.push(DUAS.ruku.speak);
  }
  else if (posId === "after_ruku") {
    texts.push(DUAS.after_ruku_sami.speak);
    texts.push(DUAS.after_ruku_rabbena.speak);
  }
  else if (posId === "sejda1" || posId === "sejda2") {
    for (let i = 0; i < 3; i++) texts.push(DUAS.sujud.speak);
  }
  else if (posId === "between") {
    texts.push(DUAS.between.speak);
  }
  else if (posId === "tashahhud") {
    texts.push(DUAS.tashahhud.speak);
    if (isLast) {
      texts.push(DUAS.salawat_salli.speak);
      texts.push(DUAS.salawat_barik.speak);
      texts.push(DUAS.rabbenatina.speak);
    }
  }
  else if (posId === "salam") {
    texts.push(DUAS.salam.speak);
  }
  return texts;
}

function pauseAutoGuide() {
  if (!autoRunning) return;
  autoPaused = !autoPaused;
  document.getElementById("pauseAutoBtn").textContent = autoPaused ? "▶ Продолжи" : "⏸ Пауза";
  if (autoPaused) {
    if (autoTimer) clearTimeout(autoTimer);
    window.speechSynthesis.cancel();
    isSpeaking = false;
    document.getElementById("autoStatus").textContent = "⏸ Пауза";
  } else {
    document.getElementById("autoStatus").textContent = "Во тек...";
    runAutoStep();
  }
}

function stopAutoGuide() {
  autoRunning = false;
  autoPaused = false;
  if (autoTimer) clearTimeout(autoTimer);
  window.speechSynthesis.cancel();
  isSpeaking = false;
  document.getElementById("startAutoBtn").classList.remove("hidden");
  document.getElementById("pauseAutoBtn").classList.add("hidden");
  document.getElementById("stopAutoBtn").classList.add("hidden");
  document.getElementById("autoStatus").textContent = "Стопирано";
  document.getElementById("autoProgressFill").style.width = "0%";
  document.getElementById("autoDetail").textContent = "";
  document.getElementById("autoResult").classList.add("hidden");
}

function finishAutoGuide() {
  autoRunning = false;
  if (autoTimer) clearTimeout(autoTimer);
  window.speechSynthesis.cancel();
  isSpeaking = false;
  document.getElementById("startAutoBtn").classList.remove("hidden");
  document.getElementById("pauseAutoBtn").classList.add("hidden");
  document.getElementById("stopAutoBtn").classList.add("hidden");
  document.getElementById("autoStatus").textContent = "✅ Намазот е завршен!";
  document.getElementById("autoProgressFill").style.width = "100%";
  document.getElementById("autoDetail").textContent = "🎉 Аллах прими!";
}

