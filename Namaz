function updateRakatOptions() {
  const key = document.getElementById("namaz").value;
  const sel = document.getElementById("rakat");
  const info = document.getElementById("rakatInfo");
  const posSel = document.getElementById("position");
  document.getElementById("manualResult").classList.add("hidden");
  sel.innerHTML = '<option value="">-- Избери рекат --</option>';
  posSel.innerHTML = '<option value="">-- Прво избери рекат --</option>';
  posSel.disabled = true;

  if (!key) { sel.disabled = true; info.classList.add("hidden"); return; }

  const data = namazData[key];
  info.innerHTML = `<strong>${data.name}</strong><br>Редослед: ${data.parts.map(p => p.label).join(" → ")}`;
  info.classList.remove("hidden");

  data.parts.forEach(part => {
    for (let i = 1; i <= part.count; i++) {
      const opt = document.createElement("option");
      opt.value = JSON.stringify({ partType: part.type, partLabel: part.label, rakatInPart: i, totalInPart: part.count });
      opt.textContent = `${part.label} – ${i}. рекат`;
      sel.appendChild(opt);
    }
  });
  sel.disabled = false;
}

function updatePositions() {
  const val = document.getElementById("rakat").value;
  const posSel = document.getElementById("position");
  document.getElementById("manualResult").classList.add("hidden");
  posSel.innerHTML = '<option value="">-- Избери положба --</option>';
  if (!val) { posSel.disabled = true; return; }

  const info = JSON.parse(val);
  const isLast = info.rakatInPart === info.totalInPart;

  positions.forEach(p => {
    if (p.id === "tashahhud" && !(info.rakatInPart === 2 || isLast || info.totalInPart === 1)) return;
    if (p.id === "salam" && !isLast) return;
    const opt = document.createElement("option");
    opt.value = p.id;
    opt.textContent = p.name;
    posSel.appendChild(opt);
  });
  posSel.disabled = false;
  if (posSel.options.length > 0) {
    posSel.value = "tekbir";
    showDuaManual();
  }
}

function showDuaManual() {
  const rakatVal = document.getElementById("rakat").value;
  const pos = document.getElementById("position").value;
  if (!pos || !rakatVal) return;
  const info = JSON.parse(rakatVal);
  document.getElementById("manualResult").classList.remove("hidden");
  document.getElementById("manualPosTitle").textContent =
    `${getPos(pos).name} – ${info.partLabel} (${info.rakatInPart}. рекат)`;
