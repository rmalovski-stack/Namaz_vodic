    desc.textContent = "Стој со рацете скрстени. Во 1. рекат Субханака + Аузу + Фатиха + сура. Во 2. Фатиха + сура. Во 3. и 4. само Фатиха.";
    if (isFirst) {
      html += makeBox(DUAS.subhanaka.ar, DUAS.subhanaka.tr, DUAS.subhanaka.mk, DUAS.subhanaka.speak, "", DUAS.subhanaka.ar);
      html += makeBox(DUAS.auzu.ar, DUAS.auzu.tr, DUAS.auzu.mk, DUAS.auzu.speak, "", DUAS.auzu.ar);
    }
    html += makeBox(DUAS.fatiha.ar, DUAS.fatiha.tr, DUAS.fatiha.mk, DUAS.fatiha.speak, "Фатиха задолжителна.", DUAS.fatiha.ar);
    if (rakatNum <= 2) {
      html += makeBox(DUAS.sura.ar, DUAS.sura.tr, DUAS.sura.mk, DUAS.sura.speak, "Пример сура.", DUAS.sura.ar);
    } else {
      html += `<div class="note">Во 3. и 4. рекат само Фатиха.</div>`;
    }
  }
  else if (posId === "ruku") {
    desc.textContent = "Кажи „Аллаху екбер“ и поклони се. Кажи најмалку 3 пати:";
    html = makeBox(DUAS.ruku.ar, DUAS.ruku.tr, DUAS.ruku.mk, DUAS.ruku.speak, "3 пати.", DUAS.ruku.ar);
  }
  else if (posId === "after_ruku") {
    desc.textContent = "Исправувајќи се од руку кажи:";
    html = makeBox(DUAS.after_ruku_sami.ar, DUAS.after_ruku_sami.tr, DUAS.after_ruku_sami.mk, DUAS.after_ruku_sami.speak, "", DUAS.after_ruku_sami.ar);
    html += makeBox(DUAS.after_ruku_rabbena.ar, DUAS.after_ruku_rabbena.tr, DUAS.after_ruku_rabbena.mk, DUAS.after_ruku_rabbena.speak, "", DUAS.after_ruku_rabbena.ar);
  }
  else if (posId === "sejda1" || posId === "sejda2") {
    desc.textContent = "Кажи „Аллаху екбер“ и падни на сеџде. Кажи најмалку 3 пати:";
    html = makeBox(DUAS.sujud.ar, DUAS.sujud.tr, DUAS.sujud.mk, DUAS.sujud.speak, "3 пати.", DUAS.sujud.ar);
  }
  else if (posId === "between") {
    desc.textContent = "Седи кратко меѓу двете сеџди и кажи:";
    html = makeBox(DUAS.between.ar, DUAS.between.tr, DUAS.between.mk, DUAS.between.speak, "", DUAS.between.ar);
  }
  else if (posId === "tashahhud") {
    desc.textContent = isLast ? "Последно седење. Тешаххуд + салават + дуа, потоа селам." : "По 2. рекат. Тешаххуд, потоа стануваш.";
    html = makeBox(DUAS.tashahhud.ar, DUAS.tashahhud.tr, DUAS.tashahhud.mk, DUAS.tashahhud.speak, "", DUAS.tashahhud.ar);
    if (isLast) {
      html += makeBox(DUAS.salawat_salli.ar, DUAS.salawat_salli.tr, DUAS.salawat_salli.mk, DUAS.salawat_salli.speak, "Салли", DUAS.salawat_salli.ar);
      html += makeBox(DUAS.salawat_barik.ar, DUAS.salawat_barik.tr, DUAS.salawat_barik.mk, DUAS.salawat_barik.speak, "Барик", DUAS.salawat_barik.ar);
      html += makeBox(DUAS.rabbenatina.ar, DUAS.rabbenatina.tr, DUAS.rabbenatina.mk, DUAS.rabbenatina.speak, "Дуа", DUAS.rabbenatina.ar);
    }
  }
  else if (posId === "salam") {
    desc.textContent = "Завршување. Прво десно, потоа лево:";
    html = makeBox(DUAS.salam.ar, DUAS.salam.tr, DUAS.salam.mk, DUAS.salam.speak, "2 пати.", DUAS.salam.ar);
  }

  content.innerHTML = html;
}

// ============================================================
// ПОСТАВУВАЊЕ НА СИТЕ AUDIO КОПЧИЊА (по вчитување)
// ============================================================
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.audio-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      const text = this.dataset.speak;
      if (text) {
        speakText(text, null);
      } else {
        console.warn("⚠️ Копчето нема data-speak атрибут:", this);
      }
    });
  });
});

// ============================================================
// ИНИЦИЈАЛИЗАЦИЈА
// ============================================================
document.getElementById("autoFigure").classList.add("pos-standing");
document.getElementById("manualFigure").classList.add("pos-standing");

// Регистрирај service worker (ако имаме sw.js, но нема – само за PWA)
if ('serviceWorker' in navigator) {
  // Ова само го активира PWA, но без sw.js работи со манифест
  // Ќе се обиде да регистрира, ако нема да не успее, но нема да се жали
  navigator.serviceWorker.register('/sw.js').catch(() => {});
}
</script>
